+class _WIN32_MEMORY_RANGE_ENTRY(ctypes.Structure):
+    _fields_ = [("VirtualAddress", ctypes.c_void_p), ("NumberOfBytes", ctypes.c_size_t)]
+
+
+def _prefetch_mmap_sequential(base_addr: int, num_bytes: int) -> None:
+    """Ask Windows to coalesce sequential HDD page-ins for ModelMMAP mappings >= 64 MiB."""
+    if os.name != "nt" or num_bytes < 64 * 1024 * 1024 or os.environ.get("EMILIA_DISABLE_MMAP_PREFETCH") == "1":
+        return
+    try:
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        prefetch = kernel32.PrefetchVirtualMemory
+        prefetch.argtypes = [
+            ctypes.c_void_p,
+            ctypes.c_size_t,
+            ctypes.POINTER(_WIN32_MEMORY_RANGE_ENTRY),
+            ctypes.c_uint32,
+        ]
+        prefetch.restype = ctypes.c_int
+        proc = kernel32.GetCurrentProcess
+        proc.restype = ctypes.c_void_p
+        chunk = 512 * 1024 * 1024
+        entry = _WIN32_MEMORY_RANGE_ENTRY()
+        hproc = proc()
+        offset = 0
+        while offset < num_bytes:
+            span = min(chunk, num_bytes - offset)
+            entry.VirtualAddress = ctypes.c_void_p(base_addr + offset)
+            entry.NumberOfBytes = span
+            prefetch(hproc, 1, ctypes.byref(entry), 0)
+            offset += span
+    except Exception:
+        pass
+
 
